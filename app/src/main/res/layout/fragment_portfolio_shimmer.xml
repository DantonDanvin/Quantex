<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Shimmer Card 1 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title shimmer -->
            <View
                android:layout_width="140dp"
                android:layout_height="16dp"
                android:background="@drawable/shimmer_placeholder" />

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <!-- Badge row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <View android:layout_width="60dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="match_parent" android:layout_height="1dp" />
                <View android:layout_width="60dp" android:layout_height="20dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shimmer Card 2 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <View android:layout_width="140dp" android:layout_height="16dp" android:background="@drawable/shimmer_placeholder" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <View android:layout_width="60dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="match_parent" android:layout_height="1dp" />
                <View android:layout_width="60dp" android:layout_height="20dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shimmer Card 3 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <View android:layout_width="140dp" android:layout_height="16dp" android:background="@drawable/shimmer_placeholder" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <View android:layout_width="60dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="match_parent" android:layout_height="1dp" />
                <View android:layout_width="60dp" android:layout_height="20dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shimmer Card 4 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <View android:layout_width="140dp" android:layout_height="16dp" android:background="@drawable/shimmer_placeholder" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <View android:layout_width="60dp" android:layout_height="20dp" android:layout_marginEnd="12dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="match_parent" android:layout_height="1dp" />
                <View android:layout_width="60dp" android:layout_height="20dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>