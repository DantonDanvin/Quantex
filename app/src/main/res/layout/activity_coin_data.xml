<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".crypto.coin.CoinData">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarcoin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="0dp"
        app:titleTextColor="@color/on_surface"
        app:titleTextAppearance="@style/Quantex.TextAppearance.TitleLarge" />

    <View android:id="@+id/toolbarDiv" android:layout_width="match_parent" android:layout_height="1dp" android:layout_below="@id/toolbarcoin" android:background="@color/divider" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary" />

    <ScrollView
        android:id="@+id/mainlayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarDiv"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Coin Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Icon + Name Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@color/transparent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:id="@+id/name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bitcoin"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/on_surface"
                                android:fontFamily="@font/circular_std"
                                android:singleLine="true"
                                android:ellipsize="marquee"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:scrollHorizontally="true"
                                android:focusable="true"
                                android:focusableInTouchMode="true" />

                            <TextView
                                android:id="@+id/symbol"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="(BTC)"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_variant"
                                android:fontFamily="@font/proxima_nova" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Price -->
                    <TextView
                        android:id="@+id/price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:fontFamily="@font/circular_std"
                        android:layout_marginBottom="4dp" />

                    <!-- Change Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/changes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textSize="14sp"
                            android:fontFamily="@font/proxima_nova"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00%"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/proxima_nova" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Chart Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                app:cardBackgroundColor="@color/surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Time Selector -->
                    <LinearLayout
                        android:id="@+id/graphtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="8dp">

                        <TextView android:id="@+id/d1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                            android:text="1D" android:gravity="center" android:textSize="13sp" android:textStyle="bold"
                            android:fontFamily="@font/proxima_nova" android:textColor="@color/chip_selected_text"
                            android:background="@drawable/chip_selected_bg" android:layout_marginEnd="4dp" />

                        <TextView android:id="@+id/w1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                            android:text="1W" android:gravity="center" android:textSize="13sp" android:textStyle="bold"
                            android:fontFamily="@font/proxima_nova" android:textColor="@color/chip_default_text"
                            android:background="@drawable/bordergraph" android:layout_marginEnd="4dp" />

                        <TextView android:id="@+id/m1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                            android:text="1M" android:gravity="center" android:textSize="13sp" android:textStyle="bold"
                            android:fontFamily="@font/proxima_nova" android:textColor="@color/chip_default_text"
                            android:background="@drawable/bordergraph" android:layout_marginEnd="4dp" />

                        <TextView android:id="@+id/m3" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                            android:text="3M" android:gravity="center" android:textSize="13sp" android:textStyle="bold"
                            android:fontFamily="@font/proxima_nova" android:textColor="@color/chip_default_text"
                            android:background="@drawable/bordergraph" android:layout_marginEnd="4dp" />

                        <TextView android:id="@+id/y1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                            android:text="1Y" android:gravity="center" android:textSize="13sp" android:textStyle="bold"
                            android:fontFamily="@font/proxima_nova" android:textColor="@color/chip_default_text"
                            android:background="@drawable/bordergraph" />

                    </LinearLayout>

                    <ProgressBar android:id="@+id/wait" android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:visibility="invisible" android:indeterminateTint="@color/primary" />

                    <TextView android:id="@+id/changegraph" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Change: 0%" android:textSize="13sp" android:fontFamily="@font/proxima_nova"
                        android:textColor="@color/on_surface_variant" android:layout_marginBottom="4dp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/line_chart"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@color/transparent" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Buy/Sell Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button android:id="@+id/buy" style="@style/Quantex.Button.Buy" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:layout_marginEnd="8dp" android:text="Buy" android:textAllCaps="false" />

                <Button android:id="@+id/sell" style="@style/Quantex.Button.Sell" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:layout_marginStart="8dp" android:text="Sell" android:textAllCaps="false" />

            </LinearLayout>

            <!-- Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider" app:cardBackgroundColor="@color/surface_card">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="About" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/on_surface" android:fontFamily="@font/circular_std" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Loading..." android:textSize="14sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Market Data Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider" app:cardBackgroundColor="@color/surface_card">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Market Data" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/on_surface" android:fontFamily="@font/circular_std" android:layout_marginBottom="12dp" />

                    <!-- Data Rows - using include-like pattern -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="UUID" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/UUID" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" android:singleLine="true" android:ellipsize="end" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rank" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/rank" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="All Time High" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/allTimeHigh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Market Cap" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/marketCap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="24h Volume" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/c24hVolume" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Exchanges" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/numberOfExchanges" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Markets" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/numberOfMarkets" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Supply Data Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider" app:cardBackgroundColor="@color/surface_card">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Supply Info" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/on_surface" android:fontFamily="@font/circular_std" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Confirmed" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/confirmed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Circulating" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/circulating" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Supply" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/total" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Max Supply" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/max" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Supply At" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/supplyAt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Listed At" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/listedAt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Change" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/Change" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fully Diluted MC" android:textSize="13sp" android:textColor="@color/on_surface_variant" android:fontFamily="@font/proxima_nova" />
                        <TextView android:id="@+id/fullyDilutedMarketCap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textSize="13sp" android:textColor="@color/on_surface" android:fontFamily="@font/proxima_nova" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>