<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".fragment.FragMarket">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/swipe_refresh_layout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:id="@+id/progress_bar"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/surface_variant" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Category Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none"
                        android:id="@+id/horizontal_only">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SearchView
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:autofillHints="Search news"
                                android:layout_gravity="center"
                                android:layout_marginEnd="12dp"
                                android:id="@+id/searchView"
                                android:queryHint="Search news..."
                                android:iconifiedByDefault="true" />

                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:id="@+id/techno"
                                android:text="Technology"
                                android:layout_marginEnd="8dp"
                                android:fontFamily="@font/proxima_nova"
                                android:textSize="13sp"
                                app:chipBackgroundColor="@color/surface_card"
                                app:chipStrokeColor="@color/divider"
                                app:chipStrokeWidth="1dp"
                                app:chipCornerRadius="20dp" />

                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:id="@+id/buss"
                                android:text="Business"
                                android:layout_marginEnd="8dp"
                                android:fontFamily="@font/proxima_nova"
                                android:textSize="13sp"
                                app:chipBackgroundColor="@color/surface_card"
                                app:chipStrokeColor="@color/divider"
                                app:chipStrokeWidth="1dp"
                                app:chipCornerRadius="20dp" />

                        </LinearLayout>

                    </HorizontalScrollView>

                    <!-- Section: Top Headlines -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Top Headlines"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/circular_std"
                        android:textColor="@color/on_surface"
                        android:paddingStart="16dp"
                        android:paddingBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:id="@+id/newsHRecyclerView" />

                    <!-- Section: Crypto News -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Crypto News"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/circular_std"
                        android:textColor="@color/on_surface"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:id="@+id/newsVRecyclerView" />

                </LinearLayout>
            </ScrollView>

        </RelativeLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
