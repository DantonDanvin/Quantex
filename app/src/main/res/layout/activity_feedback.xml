<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activitys.Feedback">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarfeedback"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="0dp"
        app:title="Feedback"
        app:titleTextAppearance="@style/Quantex.TextAppearance.TitleLarge"
        app:titleTextColor="@color/on_surface"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate Your Experience"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:fontFamily="@font/circular_std"
            android:layout_marginBottom="24dp" />

        <RatingBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/rating"
            android:layout_gravity="center"
            android:numStars="5"
            android:rating="4"
            android:stepSize="1"
            android:progressBackgroundTint="@color/on_surface_variant"
            android:progressTint="#FFC400"
            android:scaleX="0.9"
            android:scaleY="0.9" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv"
            android:text="Rating: 4.0"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textColor="@color/on_surface"
            android:fontFamily="@font/proxima_nova" />

        <Button
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:id="@+id/feedback"
            android:layout_marginTop="24dp"
            android:text="Submit"
            android:textAllCaps="false"
            style="@style/Quantex.Button.Primary" />

    </LinearLayout>

</LinearLayout>