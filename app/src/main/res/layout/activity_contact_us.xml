<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    tools:context=".activitys.ContactUs">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarcontactus"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="0dp"
        app:title="Contact Us"
        app:titleTextAppearance="@style/Quantex.TextAppearance.TitleLarge"
        app:titleTextColor="@color/on_surface"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:hint="To" style="@style/Quantex.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="allaccept101@gmail.com" android:enabled="false"
                android:fontFamily="@font/proxima_nova" android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" android:hint="Subject" style="@style/Quantex.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/subject" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/proxima_nova" android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" android:hint="Message" style="@style/Quantex.TextInputLayout">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="4" android:fontFamily="@font/proxima_nova" android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/send"
            style="@style/Quantex.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Send Message"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>