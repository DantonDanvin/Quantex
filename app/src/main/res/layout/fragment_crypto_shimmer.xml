            <View android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/shimmer_placeholder" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <View android:layout_width="58dp" android:layout_height="14dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="105dp" android:layout_height="12dp" android:layout_marginTop="6dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <View android:layout_width="72dp" android:layout_height="14dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="44dp" android:layout_height="12dp" android:layout_marginTop="6dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
