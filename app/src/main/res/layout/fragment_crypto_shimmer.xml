            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <View android:layout_width="65dp" android:layout_height="14dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="50dp" android:layout_height="12dp" android:layout_marginTop="6dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shimmer Item 4 -->
