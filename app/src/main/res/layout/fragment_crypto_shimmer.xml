                <View android:layout_width="85dp" android:layout_height="12dp" android:layout_marginTop="6dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <View android:layout_width="75dp" android:layout_height="14dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="42dp" android:layout_height="12dp" android:layout_marginTop="6dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shimmer Item 5 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/divider" app:cardBackgroundColor="@color/surface_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
            <View android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/shimmer_placeholder" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <View android:layout_width="65dp" android:layout_height="14dp" android:background="@drawable/shimmer_placeholder" />
                <View android:layout_width="95dp" android:layout_height="12dp" android:layout_marginTop="6dp" android:background="@drawable/shimmer_placeholder" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
